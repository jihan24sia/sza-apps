<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coklatt"
    tools:context=".Home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:id="@+id/background_header"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_circle_wave" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/gridLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:columnCount="2"
                    app:useDefaultMargins="true">

                    <Button
                        android:id="@+id/btnToSecond"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Pertemuan 2"
                        app:layout_columnWeight="1"
                        app:layout_gravity="fill_horizontal" />

                    <Button
                        android:id="@+id/btnToThird"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Pertemuan 3"
                        app:layout_columnWeight="1"
                        app:layout_gravity="fill_horizontal" />

                    <Button
                        android:id="@+id/btnToFourth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Pertemuan 4"
                        app:layout_columnWeight="1"
                        app:layout_gravity="fill_horizontal" />

                    <Button
                        android:id="@+id/btnToFifth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Pertemuan 5"
                        app:layout_columnWeight="1"
                        app:layout_gravity="fill_horizontal" />

                    <Button
                        android:id="@+id/btnToSeven"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Pertemuan 7"
                        app:layout_columnWeight="1"
                        app:layout_gravity="fill_horizontal" />

                    <Button
                        android:id="@+id/btnToNinth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Pertemuan 9"
                        app:layout_columnWeight="1"
                        app:layout_gravity="fill_horizontal" />

                    <Button
                        android:id="@+id/btnToTen"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Pertemuan 10"
                        app:layout_columnWeight="1"
                        app:layout_gravity="fill_horizontal" />

                </androidx.gridlayout.widget.GridLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvGallery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@android:layout/activity_list_item" />

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="32dp"
                    android:backgroundTint="@color/white"
                    android:text="Logout"
                    android:textColor="@android:color/background_dark" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>